# Пример переменных окружения. Файл .env автоматически не загружается.
# По умолчанию используется подписка ChatGPT; отдельный API нужно выбрать в UI.
REVIEWER_PORT=8765
# REVIEWER_DATA_DIR=/absolute/path/to/reviewer-data
# REVIEWER_AUTH_DIR=/absolute/path/to/protected-connections
# OPENAI_API_KEY=  # Только для явно выбранного платного API-режима.
# REVIEWER_MODEL= # Выберите доступную модель в UI, без фиксированного default slug.
